{
  "name": "berlin-under-construction-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/check-i18n.mjs && node scripts/check-public-copy.mjs && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "typecheck": "tsc --noEmit",
    "package:vercel": "npm run i18n:release-check && node scripts/package-vercel.mjs",
    "i18n:check": "node scripts/check-i18n.mjs",
    "i18n:sync": "node scripts/sync-i18n.mjs",
    "i18n:release-check": "node scripts/check-i18n.mjs --release",
    "package:preview": "node scripts/check-i18n.mjs && node scripts/package-vercel.mjs"
  },
  "dependencies": {
    "@types/three": "^0.185.4",
    "astro": "7.3.2",
    "proj4": "^2.22.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^7.0.2"
  }
}
