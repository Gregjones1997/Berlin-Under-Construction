---
import { forLocale, localeFromPath, localizePath } from "../lib/i18n";
const locale = localeFromPath(Astro.url.pathname);
const t = forLocale(locale);
interface Props {
  context: string;
}

const { context } = Astro.props;
const contact = "jonesg158@gmail.com";
---

<section>
  <h2>{t("components.CorrectionChannels.1")}</h2>
  <p>
    {t("components.CorrectionChannels.2")}
    <a href={localizePath(`mailto:${contact}`, locale)}>{contact}</a>
    {t("components.CorrectionChannels.3")}
    <strong>{context}</strong>{t("components.CorrectionChannels.4")}
  </p>
</section>

<section>
  <h2>{t("components.CorrectionChannels.5")}</h2>
  <p>
    {t("components.CorrectionChannels.6")}
  </p>
</section>

<section>
  <h2>{t("components.CorrectionChannels.7")}</h2>
  <p>
    {t("components.CorrectionChannels.8")}
  </p>
</section>

<section>
  <h2>{t("components.CorrectionChannels.9")}</h2>
  <p>
    {t("components.CorrectionChannels.10")}
  </p>
</section>
