---
import {
  EVIDENCE_LABEL_GLOSSARY,
  type PublicFact,
} from "../lib/public-projects";
import { organizationCorrectionForFact } from "../lib/organization-corrections";

interface Props {
  fact: PublicFact;
  lead?: boolean;
}

const { fact, lead = false } = Astro.props;

const FACT_LABELS: Record<string, string> = {
  financial_measure: "Financial measure",
  milestone: "Milestone",
  organization_role: "Organization role",
  project_location: "Project location",
  project_name: "Project name",
  status: "Project status",
};

const factLabel = FACT_LABELS[fact.factType] ?? "Project fact";
const humanize = (value: unknown) => String(value).replaceAll("_", " ");

const qualifiers = Array.isArray(fact.qualifiers) ? fact.qualifiers : [];
const warnings = Array.isArray(fact.displayWarnings) ? fact.displayWarnings : [];
const amount = fact.amount as
  | { value?: number; currency?: string }
  | undefined;
const dateValue = fact.dateValue as
  | { precision?: string; canonicalDe?: string }
  | undefined;
const publicationDate = fact.evidence?.publicationDate as
  | { state?: string; value?: string }
  | undefined;
const asOfDate = fact.asOfDate as
  | { state?: string; value?: string }
  | undefined;
const freshness = fact.freshness as { state?: string } | undefined;
const organizationCorrection = organizationCorrectionForFact(fact.factId);
---

<article data-fact-id={fact.factId}>
  <h3>{factLabel}</h3>
  <p lang="de" class={lead ? "value" : undefined}>{fact.valueDe}</p>
  {fact.milestoneType && <p class="meta">Milestone type: {humanize(fact.milestoneType)}</p>}
  {fact.milestoneTermDe && (
    <p class="meta">Milestone term: <span lang="de">{String(fact.milestoneTermDe)}</span></p>
  )}
  {dateValue?.canonicalDe && (
    <p class="meta">Date: <span lang="de">{dateValue.canonicalDe}</span> ({humanize(dateValue.precision)})</p>
  )}
  {fact.measureType && <p class="meta">Financial measure: {humanize(fact.measureType)}</p>}
  {amount?.value !== undefined && (
    <p class="meta">Amount: {amount.value} {amount.currency}</p>
  )}
  {fact.taxTreatment && (
    <p class="meta">Tax treatment: {humanize((fact.taxTreatment as { state?: string }).state)}</p>
  )}
  {fact.priceBasis && (
    <p class="meta">Price basis: {humanize((fact.priceBasis as { state?: string }).state)}</p>
  )}
  {fact.budgetReference && (
    <p class="meta">Budget reference: {humanize((fact.budgetReference as { state?: string }).state)}</p>
  )}
  {qualifiers.map((qualifier) => (
    <p class="meta">
      Qualifier: <span lang="de">{String((qualifier as { tokenDe?: string }).tokenDe)}</span>
    </p>
  ))}
  {asOfDate?.state && (
    <p class="meta">As of: {asOfDate.value ?? humanize(asOfDate.state)}</p>
  )}
  {freshness?.state && <p class="meta">Freshness: {humanize(freshness.state)}</p>}
  {warnings.map((warning) => <p class="meta"><strong>{String(warning)}</strong></p>)}
  {organizationCorrection && (
    <p>
      <a href={organizationCorrection.path}>
        Correction concerning {organizationCorrection.name}
      </a>
    </p>
  )}
  {fact.evidence && (
    <details>
      <summary>Evidence</summary>
      <p>
        Evidence label: {String(fact.evidence.evidenceLabel)} — {
          EVIDENCE_LABEL_GLOSSARY[String(fact.evidence.evidenceLabel)]
        }
      </p>
      <blockquote lang="de">{fact.evidence.exactTextDe}</blockquote>
      {publicationDate?.state && (
        <p>Source publication date: {publicationDate.value ?? humanize(publicationDate.state)}</p>
      )}
      <p><a href={fact.evidence.sourceUrl}>Original source</a></p>
    </details>
  )}
</article>
