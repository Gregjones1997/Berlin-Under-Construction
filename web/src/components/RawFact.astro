---
import {
  forLocale,
  localeFromPath,
  localizePath,
  enumLabel,
  factText,
  factWarning,
} from "../lib/i18n";
import type { PublicFact } from "../lib/public-projects";
import { organizationCorrectionForFact } from "../lib/organization-corrections";
import FactMetadata from "./FactMetadata.astro";
interface Props {
  fact: PublicFact;
  lead?: boolean;
  compact?: boolean;
}
const { fact, lead = false, compact = false } = Astro.props;
const locale = localeFromPath(Astro.url.pathname);
const t = forLocale(locale);
const asOf = fact.asOfDate as { value?: string; state?: string } | undefined;
const freshness = fact.freshness as { state?: string } | undefined;
const publicationDate = fact.evidence?.publicationDate as
  { value?: string; state?: string } | undefined;
const organization = organizationCorrectionForFact(fact.factId);
const hasWarnings =
  Array.isArray(fact.displayWarnings) && fact.displayWarnings.length > 0;
---

<article data-fact-id={fact.factId}>
  <h3>{enumLabel(fact.factType, locale)}</h3>
  <p lang={locale} class={lead ? "value" : undefined}>
    {factText(fact, locale)}
  </p>
  {locale === "en" && <p class="translation-note">{t("translation.note")}</p>}
  {
    compact ? (
      <details class="fact-context">
        <>
          <summary>{t("components.RawFact.11")}</summary>
          <FactMetadata fact={fact} />
        </>
      </details>
    ) : (
      <FactMetadata fact={fact} />
    )
  }
  {
    asOf?.state && (
      <p class="meta">
        {t("components.RawFact.21")}{" "}
        {asOf.value ?? enumLabel(asOf.state, locale)}
      </p>
    )
  }
  {
    freshness?.state && (
      <p class="meta">
        {t("components.RawFact.22")} {enumLabel(freshness.state, locale)}
      </p>
    )
  }
  {
    hasWarnings && (
      <p class="meta">
        <strong>{factWarning(fact, locale)}</strong>
      </p>
    )
  }
  {
    organization && (
      <p>
        <a href={localizePath(organization.path, locale)}>
          {t("components.RawFact.23")} {organization.name}
        </a>
      </p>
    )
  }
  {
    fact.evidence && (
      <details>
        <summary>{t("components.RawFact.24")}</summary>
        <p>
          {t("components.RawFact.25")}{" "}
          {t(`evidence.${fact.evidence.evidenceLabel}`)} —{" "}
          {t(`evidence.${fact.evidence.evidenceLabel}.description`)}
        </p>
        <p class="meta">{t("translation.original")}</p>
        {locale === "en" && <p lang="de">{fact.valueDe}</p>}
        <blockquote lang="de">{fact.evidence.exactTextDe}</blockquote>
        {publicationDate?.state && (
          <p>
            {t("components.RawFact.26")}{" "}
            {publicationDate.value ?? enumLabel(publicationDate.state, locale)}
          </p>
        )}
        <p>
          <a href={fact.evidence.sourceUrl}>{t("components.RawFact.27")}</a>
        </p>
      </details>
    )
  }
</article>
