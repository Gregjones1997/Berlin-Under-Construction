---
import CorrectionChannels from "../../../components/CorrectionChannels.astro";
import Base from "../../../layouts/Base.astro";
import {
  loadPublicProjectPages,
  type PublicProjectPage,
} from "../../../lib/public-projects";

export function getStaticPaths() {
  return loadPublicProjectPages().map((project) => ({
    params: { projectId: project.projectId },
    props: { project },
  }));
}

interface Props {
  project: PublicProjectPage;
}

const { project } = Astro.props;
---

<Base
  title={`Correction for ${project.projectId} — Berlin, Under Construction`}
  heading="Correction or formal request"
  subtitle={`${project.projectId} · ${project.projectNameDe}`}
>
  <CorrectionChannels context={`${project.projectId} — ${project.projectNameDe}`} />
  <section>
    <p><a href={`/projects/${project.slug}/`}>Return to project</a></p>
  </section>
</Base>
