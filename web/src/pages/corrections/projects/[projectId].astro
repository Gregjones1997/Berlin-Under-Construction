---
import {
  forLocale,
  localeFromPath,
  localizePath,
  projectName,
} from "../../../lib/i18n";
const locale = localeFromPath(Astro.url.pathname);
const t = forLocale(locale);
import CorrectionChannels from "../../../components/CorrectionChannels.astro";
import Base from "../../../layouts/Base.astro";
import {
  loadPublicProjectPages,
  type PublicProjectPage,
} from "../../../lib/public-projects";

export function getStaticPaths() {
  return loadPublicProjectPages().map((project) => ({
    params: { projectId: project.projectId },
    props: { project },
  }));
}

interface Props {
  project: PublicProjectPage;
}

const { project } = Astro.props;
---

<Base
  title={t("correction.project.title", { id: project.projectId })}
  heading={t("pages.corrections.organizations.50hertz.45")}
  subtitle={`${project.projectId} · ${projectName(project, locale)}`}
>
  <CorrectionChannels
    context={`${project.projectId} — ${projectName(project, locale)}`}
  />
  <section>
    <p>
      <a href={localizePath(`/projects/${project.slug}/`, locale)}
        >{t("pages.corrections.organizations.50hertz.47")}</a>
    </p>
  </section>
</Base>
