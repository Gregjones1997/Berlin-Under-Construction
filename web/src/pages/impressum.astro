---
import { forLocale, localeFromPath, localizePath } from "../lib/i18n";
const locale = localeFromPath(Astro.url.pathname);
const t = forLocale(locale);
import Base from "../layouts/Base.astro";
import { requireLegalAddress } from "../lib/legal-contact";

const address = requireLegalAddress(
  process.env.LEGAL_ADDRESS ?? "[[ANSCHRIFT]]",
