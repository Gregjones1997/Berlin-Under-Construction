---

<Base title={t("pages.impressum.48")} heading={t("layouts.Base.37")}>
  <section>
    <h2>{t("pages.impressum.49")}</h2>
    <p>
      Gregory Anthony Jones<br />
      {address}<br />
      {t("pages.impressum.50")}
