  </section>

  <section>
    <h2>{t("components.CorrectionChannels.1")}</h2>
    <p>
      {t("pages.impressum.51")}
      <a href="mailto:jonesg158@gmail.com">jonesg158@gmail.com</a>
    </p>
  </section>

  <section>
    <h2>{t("pages.impressum.52")}</h2>
    <p>{t("pages.impressum.53")}</p>
  </section>

  <section>
