---
import { readFileSync } from "node:fs";
import places from "../atlas/places.json";
import { resolve } from "node:path";
import { loadPublicProjectPages } from "../lib/public-projects";
import { publicationAsOfDate } from "../lib/milestone-freshness.mjs";
import RawFact from "../components/RawFact.astro";
import Icon from "../components/AtlasIcon.astro";
import SiteHeader from "../components/SiteHeader.astro";
import contextLabels from "../atlas/context-labels.json";
import "../styles/atlas.css";
const projects = loadPublicProjectPages();
const positions = JSON.parse(
  readFileSync(
    resolve("../public/data/map/pilot-marker-positions.json"),
    "utf8",
  ),
).positions as { projectId: string; latitude: number; longitude: number }[];
const generatedOn = publicationAsOfDate(process.env.PUBLICATION_AS_OF_DATE);
const records = projects.map((project) => ({
  ...project,
  position: positions.find((p) => p.projectId === project.projectId),
  lead:
    project.publishedFacts.find(
      (f) => f.factType === "milestone" && f.factId.endsWith("current"),
    ) ?? project.publishedFacts.find((f) => f.factType === "milestone"),
  start: project.publishedFacts.find(f => f.factId.endsWith("construction-start-current")),
  status: project.publishedFacts.find(f => f.factType === "status"),
  history: project.publishedFacts.filter((f) => f.factId.includes("history")),
}));
---

<!doctype html>
<html lang="en">
  <head
    ><meta charset="utf-8" /><meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    /><meta
      name="description"
      content="Explore Berlin through an architectural city model and source-backed construction records. What is being built, what was promised, and what changed."
    /><meta name="theme-color" content="#f3f1eb" /><title>
      Berlin, Under Construction — The city, in progress.
    </title></head
  >
  <body class="atlas-page">
    <a class="skip-link" href="#project-list">Skip to project records</a>
    <SiteHeader />
    <main id="atlas" class="atlas-shell">
      <div
        id="map-stage"
        class="map-stage"
        role="region"
        aria-label="Interactive architectural map of Berlin"
      >
        <div class="map-loading" id="map-loading" role="status">
          <span class="loading-mark">B<span>.</span></span><p
            id="loading-message"
          >
            Assembling the city
          </p><small>Real geometry. A closer look.</small>
        </div>
        <div class="map-failure" id="map-failure" hidden>
          <h2>The atlas could not load.</h2><p id="failure-message">
            Your browser may not support this 3D view.
          </p><a href="/records/">Explore the accessible project index →</a
          ><button id="retry-map" type="button">Try again</button>
        </div>
        <div class="context-labels" aria-hidden="true">
          {
            contextLabels.labels.map((label) => (
              <span
                class="context-label"
                data-kind={label.kind}
                data-min-zoom={label.minZoom}
                data-lon={label.longitude}
                data-lat={label.latitude}
                lang="de"
                hidden
              >
                {label.name}
              </span>
            ))
          }
        </div>
        <div class="map-markers" id="map-markers">
          {
            records
              .filter((r) => r.position)
              .map((project, index) => (
                <button
                  class="project-pin"
                  data-project={project.projectId}
                  data-lon={project.position!.longitude}
                  data-lat={project.position!.latitude}
                  aria-label={`Explore ${project.projectNameDe}`}
                  hidden
                >
                  <>
                    <span class="pin-number">
                      <Icon name={project.projectId === "C-014" ? "publicspace" : "school"} />
                    </span>
                    <span class="pin-label" lang="de">
                      {project.projectNameDe}
                    </span>
                  </>
                </button>
              ))
          }
        </div>
      </div>
      <aside class="atlas-left" aria-label="Explore project records">
        <div class="atlas-intro">
          <p class="eyebrow">A SOURCE-BACKED VIEW OF BERLIN</p><h1>
            The city,<br /><em>in progress.</em>
          </h1><p>What is being built.<br />What was promised. What changed.</p>
        </div>
        <details class="project-picker" open id="project-picker">
          <summary id="project-list"
            ><span>Explore the projects</span><span class="count">03</span
            ></summary
          >
          <div class="project-list">
            {
              records.map((project, index) => (
                <div class="project-entry">
                  <>
                    <button
                      class="project-select"
                      data-project={project.projectId}
                      aria-controls={`record-${project.projectId}`}
                      aria-expanded="false"
                    >
                      <>
                        <span class="project-number">
                          {String(index + 1).padStart(2, "0")}
                        </span>
                        <span>
                          <>
                            <strong lang="de">{project.projectNameDe}</strong>
                            <small>
                              {project.position
                                ? "Placed in the atlas"
                                : "Location withheld"}
                            </small>
                          </>
                        </span>
                        <span class="entry-arrow" aria-hidden="true">
                          ↗
                        </span>
                      </>
                    </button>
                    <a class="entry-static" href={`/projects/${project.slug}/`}>
                      Read dossier →
                    </a>
                  </>
                </div>
              ))
            }
          </div>
        </details>
      </aside>
      <button class="city-return" id="back-to-city" hidden><Icon name="arrow" /> Back to previous view</button>
      <aside
        class="record-panel"
        id="record-panel"
        aria-label="Selected project"
        hidden
        tabindex="-1"
      >
        <button
          class="panel-close icon-button"
          id="close-record"
          aria-label="Close project record"><Icon name="close" /></button
        >
        {
          records.map((project, index) => (
            <section
              id={`record-${project.projectId}`}
              class="project-record"
              hidden
            >
              <div class="record-heading">
                <>
                  <p class="eyebrow">
                    PROJECT RECORD / {String(index + 1).padStart(2, "0")}
                  </p>
                  <h2 lang="de">{project.projectNameDe}</h2>
                  <p class="record-id">
                    {project.projectId} · Source-backed dossier
                  </p>
                </>
              </div>
              {!project.position && (
                <p class="withheld-note">
                  Location withheld pending source verification. This record
                  remains available without a map marker.
                </p>
              )}
              <div data-record-section="overview" class="project-brief status-brief">
                {project.projectId === "C-014" && project.start && <p class="brief-description" lang="de">Vorplatz des Hauptbahnhofs an der Invalidenstraße <a class="fact-source" href={project.start.evidence?.sourceUrl} aria-label="Source for project description">↗</a></p>}
                {project.status && <div class="status-line" data-fact-id={project.status.factId}>
                  <span class="source-status" lang="de">{project.status.valueDe}</span>
                  <a class="fact-source" href={project.status.evidence?.sourceUrl} aria-label="Source for reported status">↗</a>
                  <small>Source status · {String((project.status.asOfDate as {value?: string})?.value ?? "date not stated")}</small>
                </div>}
                <dl class="brief-dates">
                  <div>
                    <dt>Start <small>announced</small></dt>
                    <dd>{project.start ? <><span lang="de">{String((project.start.dateValue as {canonicalDe?: string})?.canonicalDe ?? project.start.valueDe)}</span><a class="fact-source" href={project.start.evidence?.sourceUrl} aria-label="Source for announced start">↗</a></> : <span class="date-missing">Not recorded</span>}</dd>
                  </div>
                  <div>
                    <dt><span lang="de">{String(project.lead?.milestoneTermDe ?? "End")}</span> <small>planned</small></dt>
                    <dd>{project.lead ? <><span lang="de">{String((project.lead.dateValue as {canonicalDe?: string})?.canonicalDe ?? project.lead.valueDe)}</span><a class="fact-source" href={project.lead.evidence?.sourceUrl} aria-label="Source for planned milestone">↗</a></> : <span class="date-missing">Not recorded</span>}</dd>
                  </div>
                </dl>
                {((project.lead?.displayWarnings ?? []) as string[]).length > 0 && <p class="brief-warning">Target date passed; completion unconfirmed.</p>}
                <p class="brief-source-key">Planned dates do not confirm actual progress. <span>↗ Original source</span></p>
                <button class="brief-more brief-overview-link" data-expand-record><span><strong>Full project overview</strong><small>Details, cited history &amp; sources</small></span><Icon name="arrow" /></button>
                <a href={project.correctionPath} class="correction-link">Suggest a correction</a>
              </div>
              <div data-record-section="history" hidden>
                <p class="history-note">
                  Dates describe source statements, not observed construction
                  progress.
                </p>
                <h3 class="history-title">Project overview</h3>
                {project.publishedFacts.filter((f) => !project.history.includes(f)).map((fact) => <RawFact fact={fact} />)}
                <h3 class="history-title">Source history</h3>
                {project.history.length ? (
                  project.history.map((f) => <RawFact fact={f} />)
                ) : (
                  <p>
                    No separate milestone history is published for this project.
                  </p>
                )}
                {project.conflicts.map((conflict) => <section class="record-conflict" data-conflict-id={conflict.conflictId}><h3>Unresolved source conflict</h3>{conflict.facts.map((fact) => <RawFact fact={fact} />)}</section>)}
                {project.withheldFacts.length > 0 && <section class="record-withheld"><h3>Withheld facts</h3>{project.withheldFacts.map((fact) => <p>{fact.factType.replaceAll("_", " ")} · {fact.reasonCode?.replaceAll("_", " ")}</p>)}</section>}
              </div>
              <div class="record-actions full-record-actions">
                <>
                  <a class="primary-link" href={`/projects/${project.slug}/`}>
                    Open full dossier <Icon name="arrow" />
                  </a>
                  <a href={project.correctionPath} class="correction-link">
                    Suggest a correction
                  </a>
                </>
              </div>
            </section>
          ))
        }
      </aside>
      <div class="city-explorer">
        <span class="explorer-label">Explore Berlin</span>
        <details id="area-picker">
          <summary><span id="area-name">Choose an area</span><span aria-hidden="true">⌄</span></summary>
          <div class="area-options">
            <button type="button" data-area="overview">City overview</button>
            {places.places.map((p) => <button type="button" data-area={`${p.longitude},${p.latitude}`}>{p.name}</button>)}
          </div>
        </details>
        <span id="detail-status" role="status"></span>
      </div>
      <div class="map-right-controls" role="group" aria-label="Map navigation">
        <button id="north" class="north-button" aria-label="Orient map north"
          ><span id="north-arrow">↑</span><small>N</small></button
        ><div class="zoom-stack">
          <button id="zoom-in" aria-label="Zoom in"><Icon name="plus" /></button
          ><button id="zoom-out" aria-label="Zoom out"
            ><Icon name="minus" /></button
          >
        </div>
      </div>
      <div class="map-bottom">
        <div class="map-readout">
          <span class="eyebrow" id="view-label">BERLIN</span><span
            class="scale-rule"
            id="scale-rule"></span><span id="scale-label">1 km</span>
        </div>
        <div class="map-toolbar" role="group" aria-label="Atlas controls">
          <button id="home-view"
            ><Icon name="compass" /><span>Overview</span></button
          ><button id="orbit-view" aria-pressed="false"
            ><Icon name="play" /><span>Orbit</span></button
          ><span class="toolbar-divider"></span><button
            id="plan-view"
            aria-pressed="false"
            ><Icon name="layers" /><span>Plan view</span></button
          ><button
            id="labels-view"
            aria-expanded="false"
            aria-controls="label-panel"
            ><Icon name="map" /><span>Project key</span></button
          ><span class="toolbar-divider"></span><button
            id="fullscreen-view"
            aria-label="Enter fullscreen"><Icon name="expand" /></button
          >
        </div>
        <button id="about-map" class="about-map" aria-haspopup="dialog"
          ><Icon name="info" /> About this model</button
        >
      </div>
      <section
        class="label-panel"
        id="label-panel"
        aria-label="Project map key"
        hidden
      >
        <div class="label-panel-heading">
          <h2>Project map key</h2><button
            id="close-labels"
            class="icon-button"
            aria-label="Close label controls"><Icon name="close" /></button
          >
        </div>
        <label
          ><span class="legend-symbol legend-category"><Icon name="pin" /></span><span
            >Project markers<small>Source-backed evidence records</small></span
          ><input type="checkbox" data-label-kind="projects" checked /></label
        >
        <div class="project-category-key">
          <button class="legend-project-link" data-project="C-014"><span class="legend-symbol legend-category"><Icon name="publicspace" /></span><span>Public space<small>Europaplatz Süd</small></span></button>
          <button class="legend-project-link" data-project="C-010"><span class="legend-symbol legend-category"><Icon name="school" /></span><span>School<small>Heinrich-Hertz-Gymnasium</small></span></button>
          <button class="legend-project-link" data-project="C-019"><span class="legend-symbol legend-category"><Icon name="energy" /></span><span>Energy<small>Power-to-Heat · location withheld</small></span></button>
        </div>
        <p>Project types describe the work, not its progress. More types appear as researched projects are added.</p>
      </section>
      <p class="interaction-hint" id="interaction-hint">
        Drag to explore <span>·</span> Scroll to zoom <span>·</span> Right-drag to
        rotate
      </p>
      <div
        class="selection-status sr-only"
        id="selection-status"
        aria-live="polite"
      >
      </div>
    </main>
    <footer class="atlas-footer">
      <span
        >Geometry: <a
          href="https://daten.berlin.de/datensaetze/gebaudehohen-umweltatlas-wfs-d918088d"
          >Geoportal Berlin</a
        > · <a href="https://www.openstreetmap.org/copyright"
          >© OpenStreetMap contributors</a
        ></span
      ><span class="footer-center"
        >A model of the city. An evidence trail for its future.</span
      ><nav aria-label="Legal information">
        <a href="/impressum/">Impressum</a><a href="/privacy/">Privacy</a><a
          href="/corrections/">Corrections</a
        >
      </nav>
    </footer>
    <dialog id="model-dialog">
      <button
        class="dialog-close icon-button"
        id="close-model"
        aria-label="Close model information"><Icon name="close" /></button
      ><p class="eyebrow">THE MAP, EXPLAINED</p><h2>
        A city model.<br /><em>Not a live survey.</em>
      </h2><p>
        This architectural view uses real building footprints and
        source-recorded heights. Buildings are simplified extrusions; roof
        shapes and facades are not reconstructed. The model does not show
        current construction progress.
      </p><dl>
        <div>
          <dt>Building geometry</dt><dd>
            Geoportal Berlin · Gebäudehöhen 2022 (Umweltatlas), derived from
            ALKIS footprints and the LoD2 model. <a
              href="https://www.govdata.de/dl-de/zero-2-0">dl-de/zero-2-0</a
            >.
          </dd>
        </div><div>
          <dt>Geographic context</dt><dd>
            © <a href="https://www.openstreetmap.org/copyright"
              >OpenStreetMap contributors</a
            >, ODbL. Simplified water, green space and transport geometry. Road
            widths and bridge elevations are illustrative.
          </dd>
        </div><div>
          <dt>Coverage & precision</dt><dd id="model-coverage">
            Citywide building coverage with detail loaded as you explore.
            Building shapes smaller than 50 m² are omitted; coordinates are
            rounded to 0.5 m. The overview uses simplified footprints of shapes
            at least 500 m². Source gaps remain gaps. Geometry predates these
            project records.
          </dd>
        </div><div>
          <dt>Project evidence</dt><dd>
            Only two of three pilot projects have published positions. Dates and
            statements retain their individual sources; map geometry is not
            project-status evidence.
          </dd>
        </div><div>
          <dt>Privacy & access</dt><dd>
            Model assets are served with this site. No map provider, analytics,
            location permission or account is required. The <a href="/records/"
              >project index</a
            > and dossiers work without JavaScript.
          </dd>
        </div>
      </dl><details class="label-sources">
        <summary>Explore Berlin · navigation sources</summary><p>
          Area names and navigation anchors from OpenStreetMap; these are not
          project locations.
        </p><ul>
          {
            places.places.map((p) => (
              <li>
                <a href={p.sourceUrl}>{p.name}</a>
              </li>
            ))
          }
        </ul>
      </details><details class="label-sources">
        <summary
          >Geographic label sources · {contextLabels.labels.length}</summary
        ><p>
          German place names from OpenStreetMap, snapshot 7 September 2026.
          Label anchors are approximate cartographic positions, not project
          locations.
        </p><ul>
          {
            contextLabels.labels.map((label) => (
              <li>
                <a href={label.sourceUrl} lang="de">
                  {label.name}
                </a>
              </li>
            ))
          }
        </ul>
      </details>
      <p class="model-date">
        This page was generated on {generatedOn}. Data dates vary by source.
      </p><a href="/method/" class="primary-link"
        >Read the method <Icon name="arrow" /></a
      >
    </dialog>
    <noscript
      ><div class="noscript-note">
        The 3D atlas requires JavaScript. <a href="/records/"
          >Open the accessible map and project index →</a
        >
      </div></noscript
    >
    <script>
      import "../atlas/controller";
    </script>
  </body>
</html>
