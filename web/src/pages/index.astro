---
import {
  forLocale,
  localeFromPath,
  localizePath,
  projectName,
  listingName,
  factText,
  cardDate,
  enumLabel,
} from "../lib/i18n";
const locale = localeFromPath(Astro.url.pathname);
const t = forLocale(locale);
import { readFileSync } from "node:fs";
import { loadBasicMilestones } from "../lib/basic-milestones.mjs";
import basicListings from "../atlas/basic-listings.json";
import places from "../atlas/places.json";
import { resolve } from "node:path";
import { loadPublicProjectPages } from "../lib/public-projects";
import { publicationAsOfDate } from "../lib/milestone-freshness.mjs";
import ProjectRecordPanel from "../components/ProjectRecordPanel.astro";
import TranslationDisclosure from "../components/TranslationDisclosure.astro";
import Icon from "../components/AtlasIcon.astro";
import SiteHeader from "../components/SiteHeader.astro";
import contextLabels from "../atlas/context-labels.json";
import "../styles/atlas.css";
const projects = loadPublicProjectPages();
const basicMilestones = loadBasicMilestones(
  basicListings.records.map((project) => project.id),
);
const positions = JSON.parse(
  readFileSync(
    resolve("../public/data/map/pilot-marker-positions.json"),
    "utf8",
  ),
).positions as { projectId: string; latitude: number; longitude: number }[];
const generatedOn = publicationAsOfDate(process.env.PUBLICATION_AS_OF_DATE);
const records = projects.map((project) => ({
  ...project,
  position: positions.find((p) => p.projectId === project.projectId),
  lead:
    project.publishedFacts.find(
      (f) => f.factType === "milestone" && f.factId.endsWith("current"),
    ) ?? project.publishedFacts.find((f) => f.factType === "milestone"),
  start: project.publishedFacts.find((f) =>
    f.factId.endsWith("construction-start-current"),
  ),
  status: project.publishedFacts.find((f) => f.factType === "status"),
  history: project.publishedFacts.filter((f) => f.factId.includes("history")),
}));
---

<!doctype html>
<html lang={locale} data-publication-date={generatedOn}>
  <head
    ><meta charset="utf-8" />
    <link
      rel="alternate"
      hreflang="de"
      href={localizePath(Astro.url.pathname, "de")}
    />
    <link
      rel="alternate"
      hreflang="en"
      href={localizePath(Astro.url.pathname, "en")}
    /><meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    /><meta name="description" content={t("pages.index.58")} /><meta
      name="theme-color"
      content="#f3f1eb"
    /><title>
      {t("pages.index.59")}
    </title></head
  >
  <body class="atlas-page">
    <a class="skip-link" href={localizePath("/records/", locale)}
      >{t("pages.index.60")}</a
    >
    <SiteHeader />
    <main id="atlas" class="atlas-shell">
      <div
        id="map-stage"
        class="map-stage"
        role="region"
        aria-label={t("pages.index.61")}
      >
        <div class="map-loading" id="map-loading" role="status">
          <span class="loading-mark">B<span>.</span></span><p
            id="loading-message"
          >
            {t("pages.index.62")}
          </p><small>{t("pages.index.63")}</small>
        </div>
        <div
          class="map-failure"
          id="map-failure"
          role="alert"
          aria-labelledby="failure-heading"
          aria-describedby="failure-message"
          tabindex="-1"
          hidden
        >
          <h2 id="failure-heading">{t("pages.index.64")}</h2><p
            id="failure-message"
          >
            {t("pages.index.65")}
          </p><div class="failure-actions">
            <a href={localizePath("/records/", locale)}>{t("pages.index.66")}</a
            ><button id="retry-map" type="button">{t("pages.index.67")}</button>
          </div>
        </div>
        <div class="context-labels" aria-hidden="true">
          {
            contextLabels.labels.map((label) => (
              <span
                class="context-label"
                data-kind={label.kind}
                data-min-zoom={label.minZoom}
                data-lon={label.longitude}
                data-lat={label.latitude}
                lang="de"
                hidden
              >
                {label.name}
              </span>
            ))
          }
        </div>
        <div class="map-markers" id="map-markers">
          {
            records
              .filter((r) => r.position)
              .map((project, index) => (
                <button
                  class="project-pin"
                  data-project={project.projectId}
                  data-lon={project.position!.longitude}
                  data-lat={project.position!.latitude}
                  aria-label={t("atlas.explore", {
                    name: projectName(project, locale),
                  })}
                  hidden
                >
                  <>
                    <span class="pin-number">
                      <Icon
                        name={
                          project.projectId === "C-014"
                            ? "publicspace"
                            : "school"
                        }
                      />
                    </span>
                    <span class="pin-label" lang={locale}>
                      {projectName(project, locale)}
                    </span>
                  </>
                </button>
              ))
          }
          {
            basicListings.records.map((project) => (
              <button
                class="project-pin basic-pin"
                data-depth="basic"
                data-project={project.id}
                data-lon={project.longitude}
                data-lat={project.latitude}
                aria-label={t("atlas.explore.basic", {
                  name: listingName(project, locale),
                })}
                hidden
              >
                <>
                  <span class="pin-number">
                    <Icon name="pin" />
                  </span>
                  <span class="pin-label" lang={locale}>
                    {listingName(project, locale)}
                  </span>
                </>
              </button>
            ))
          }
        </div>
      </div>

      <aside class="atlas-left" aria-label={t("pages.index.68")}>
        <div class="atlas-intro">
          <p class="eyebrow">{t("pages.index.69")}</p><h1>
            {t("pages.index.70")}<br />{t("pages.index.71")}
          </h1><p>{t("pages.index.72")}</p>
        </div>
        <details class="project-picker" open id="project-picker">
          <summary id="project-list"
            ><span>{t("pages.index.73")}</span><span class="count"
              >{String(records.length).padStart(2, "0")}</span
            ></summary
          >
          <div class="project-list">
            {
              records.map((project, index) => (
                <div class="project-entry">
                  <>
                    <button
                      class="project-select"
                      data-project={project.projectId}
                      aria-controls={`record-${project.projectId}`}
                      aria-expanded="false"
                    >
                      <>
                        <span class="project-number">
                          {String(index + 1).padStart(2, "0")}
                        </span>
                        <span>
                          <>
                            <strong lang={locale}>
                              {projectName(project, locale)}
                            </strong>
                            <small>
                              {project.position
                                ? t("pages.index.74")
                                : t("pages.index.75")}
                            </small>
                          </>
                        </span>
                        <span class="entry-arrow" aria-hidden="true">
                          ↗
                        </span>
                      </>
                    </button>
                    <a
                      class="entry-static"
                      href={localizePath(`/projects/${project.slug}/`, locale)}
                    >
                      {t("pages.index.76")}
                    </a>
                  </>
                </div>
              ))
            }
          </div>
        </details>
        <div class="atlas-coverage">
          <p class="coverage-purpose">{t("pages.index.77")}</p><a
            href={localizePath("/records/", locale)}
            >{t("pages.index.78")}{" "}
            {records.length}{" "}
            {t("pages.index.79")}
            <span> / </span>
            {basicListings.records.length}{" "}
            {t("pages.index.80")}
            <span aria-hidden="true">↗</span></a
          ><small>{t("pages.index.81")}</small>
        </div>
      </aside>
      <button class="city-return" id="back-to-city" hidden
        ><Icon name="arrow" /> {t("pages.index.82")}</button
      >
      <aside
        class="record-panel"
        id="record-panel"
        aria-label={t("pages.index.83")}
        hidden
        tabindex="-1"
      >
        <button
          class="panel-close icon-button"
          id="close-record"
          aria-label={t("pages.index.84")}><Icon name="close" /></button
        >
        {
          records.map((project, index) => (
            <ProjectRecordPanel project={project} index={index} />
          ))
        }
        {
          basicListings.records.map((project) => (
            <section
              id={`record-${project.id}`}
              class="project-record basic-record"
              hidden
            >
              <div class="record-heading">
                <>
                  <p class="eyebrow">{t("pages.index.110")}</p>
                  <h2 lang={locale}>{listingName(project, locale)}</h2>
                </>
              </div>
              <div
                class="project-brief status-brief"
                data-record-section="overview"
              >
                {basicMilestones.some(
                  (fact) => fact.projectId === project.id,
                ) && (
                  <dl
                    class="brief-dates basic-dates"
                    aria-label={t("pages.index.111")}
                  >
                    {basicMilestones
                      .filter((fact) => fact.projectId === project.id)
                      .map((fact) => (
                        <div data-basic-milestone={fact.kind}>
                          <dt>{t(`basic.${fact.kind}`)}</dt>
                          <dd>
                            <span lang={locale}>
                              {cardDate(fact.valueDe, locale)}
                            </span>
                            <a
                              class="fact-source"
                              href={fact.sourceUrl}
                              aria-label={t("atlas.source.basic", {
                                label: t(`basic.${fact.kind}`),
                              })}
                            >
                              <Icon name="arrow" />
                            </a>
                          </dd>
                        </div>
                      ))}
                  </dl>
                )}
                <p lang="de">{project.locationDe}</p>
                <p class="brief-source-key">{t("pages.index.112")}</p>
                <a
                  class="brief-more brief-overview-link"
                  href={project.sourceUrl}
                >
                  <>
                    <span>
                      <strong>{t("pages.index.113")}</strong>
                    </span>
                    <Icon name="arrow" />
                  </>
                </a>
                <details class="basic-evidence">
                  <summary>{t("card.basicEvidence")}</summary>
                  <p lang="de">{project.nameDe}</p>
                  {basicMilestones
                    .filter((fact) => fact.projectId === project.id)
                    .map((fact) => (
                      <div class="milestone-evidence">
                        <p lang="de">{fact.exactTextDe}</p>
                        <p>
                          {t("pages.index.116")}{" "}
                          <span lang="de">{fact.sourceModifiedDateDe}</span>{" "}
                          {t("pages.index.117")} {fact.retrievedOn.slice(0, 10)}
                        </p>
                        <a href={fact.sourceUrl}>{t("pages.index.118")}</a>
                      </div>
                    ))}
                  <a href={project.evidence.inventory_url}>
                    {t("pages.index.119")}
                  </a>
                  <>
                    <p>
                      {t("pages.index.120")}{" "}
                      <code>{project.evidence.location_pointer}</code>
                    </p>
                    <p>
                      {t("pages.index.121")}{" "}
                      <code>{project.evidence.artifact_hash}</code>
                    </p>
                  </>
                </details>
                <a
                  href={localizePath("/corrections/", locale)}
                  class="correction-link"
                >
                  {t("pages.index.122")} {project.id}
                </a>
                <TranslationDisclosure />
              </div>
            </section>
          ))
        }
      </aside>
      <div class="city-explorer">
        <span class="explorer-label">{t("pages.index.123")}</span>
        <details id="area-picker">
          <summary
            ><span id="area-name">{t("pages.index.124")}</span><span
              aria-hidden="true">⌄</span
            ></summary
          >
          <div class="area-options">
            <button type="button" data-area="overview"
              >{t("pages.index.125")}</button
            >
            {
              places.places.map((p) => (
                <button
                  type="button"
                  data-area={`${p.longitude},${p.latitude}`}
                >
                  {p.name}
                </button>
              ))
            }
          </div>
        </details>
        <span id="detail-status" role="status"></span>
      </div>
      <div
        class="map-right-controls"
        role="group"
        aria-label={t("pages.index.126")}
      >
        <button
          id="north"
          class="north-button"
          aria-label={t("pages.index.127")}
          ><span id="north-arrow">↑</span><small>N</small></button
        ><div class="zoom-stack">
          <button id="zoom-in" aria-label={t("pages.index.128")}
            ><Icon name="plus" /></button
          ><button id="zoom-out" aria-label={t("pages.index.129")}
            ><Icon name="minus" /></button
          >
        </div>
      </div>
      <div class="map-bottom">
        <div class="map-readout">
          <span class="eyebrow" id="view-label">BERLIN</span><span
            class="scale-rule"
            id="scale-rule"></span><span id="scale-label"
            >{t("pages.index.130")}</span
          >
        </div>
        <div class="map-toolbar" role="group" aria-label={t("pages.index.131")}>
          <button id="home-view"
            ><Icon name="compass" /><span>{t("pages.index.132")}</span></button
          ><button id="orbit-view" aria-pressed="false"
            ><Icon name="play" /><span>{t("pages.index.133")}</span></button
          ><span class="toolbar-divider"></span><button
            id="plan-view"
            aria-pressed="false"
            ><Icon name="layers" /><span>{t("pages.index.134")}</span></button
          ><button
            id="labels-view"
            aria-expanded="false"
            aria-controls="label-panel"
            ><Icon name="map" /><span>{t("pages.index.135")}</span></button
          ><span class="toolbar-divider"></span><button
            id="fullscreen-view"
            aria-label={t("pages.index.136")}><Icon name="expand" /></button
          >
        </div>
        <button id="about-map" class="about-map" aria-haspopup="dialog"
          ><Icon name="info" /> {t("pages.index.137")}</button
        >
      </div>
      <section
        class="label-panel"
        id="label-panel"
        aria-label={t("pages.index.138")}
        hidden
      >
        <div class="label-panel-heading">
          <h2>{t("pages.index.138")}</h2><button
            id="close-labels"
            class="icon-button"
            aria-label={t("pages.index.139")}><Icon name="close" /></button
          >
        </div>
        <label
          ><span class="legend-symbol legend-category"><Icon name="pin" /></span
          ><span
            >{t("pages.index.140")}<small>{t("pages.index.141")}</small></span
          ><input type="checkbox" data-label-kind="projects" checked /></label
        >
        <label
          ><span class="legend-symbol"><Icon name="pin" /></span><span
            >{t("pages.index.142")}<small>{t("pages.index.143")}</small></span
          ><input type="checkbox" data-label-kind="basic" checked /></label
        >
        <div class="place-filter">
          <label for="basic-place-filter">{t("pages.index.144")}</label>
          <select id="basic-place-filter">
            <option value="">{t("pages.index.145")}</option>
            {
              places.places.map((place) => (
                <option value={`${place.longitude},${place.latitude}`}>
                  {place.name}
                </option>
              ))
            }
          </select>
          <p id="place-filter-status" role="status">{t("pages.index.146")}</p>
          <small>{t("pages.index.147")}</small>
        </div>
        <div class="project-category-key">
          <button class="legend-project-link" data-project="C-014"
            ><span class="legend-symbol legend-category"
              ><Icon name="publicspace" /></span
            ><span
              >{t("pages.index.148")}<small>{t("pages.index.149")}</small></span
            ></button
          >
          <button class="legend-project-link" data-project="C-010"
            ><span class="legend-symbol legend-category"
              ><Icon name="school" /></span
            ><span
              >{t("pages.index.150")}<small>{t("pages.index.151")}</small></span
            ></button
          >
          <button class="legend-project-link" data-project="C-019"
            ><span class="legend-symbol legend-category"
              ><Icon name="energy" /></span
            ><span
              >{t("pages.index.152")}<small>{t("pages.index.153")}</small></span
            ></button
          >
        </div>
        <p>{t("pages.index.154")}</p>
        <details class="basic-directory">
          <summary>{t("pages.index.155")}</summary>{
            basicListings.records.map((project) => (
              <button
                class="project-select"
                data-project={project.id}
                aria-expanded="false"
              >
                <>
                  <strong lang={locale}>{listingName(project, locale)}</strong>
                  <Icon name="arrow" />
                </>
              </button>
            ))
          }
        </details>
      </section>
      <p class="interaction-hint" id="interaction-hint">
        {t("pages.index.156")}
        <span>·</span>
        {t("pages.index.157")}
        <span>·</span>
        {t("pages.index.158")}
      </p>
      <div
        class="selection-status sr-only"
        id="selection-status"
        aria-live="polite"
      >
      </div>
    </main>
    <footer class="atlas-footer">
      <span
        >{t("pages.index.159")}
        <a
          href="https://daten.berlin.de/datensaetze/gebaudehohen-umweltatlas-wfs-d918088d"
          >{t("pages.index.160")}</a
        > · <a href="https://www.openstreetmap.org/copyright"
          >{t("pages.index.161")}</a
        ></span
      ><span class="footer-center">{t("pages.index.162")}</span><nav
        aria-label={t("pages.index.163")}
      >
        <a href={localizePath("/impressum/", locale)}>{t("layouts.Base.37")}</a
        ><a href={localizePath("/privacy/", locale)}>{t("layouts.Base.38")}</a
        ><a href={localizePath("/corrections/", locale)}
          >{t("pages.index.164")}</a
        >
      </nav>
    </footer>
    <dialog id="model-dialog">
      <button
        class="dialog-close icon-button"
        id="close-model"
        aria-label={t("pages.index.165")}><Icon name="close" /></button
      ><p class="eyebrow">{t("pages.index.166")}</p><h2>
        {t("pages.index.167")}<br /><em>{t("pages.index.168")}</em>
      </h2><p>
        {t("pages.index.169")}
      </p><dl>
        <div>
          <dt>{t("pages.index.170")}</dt><dd>
            {t("pages.index.171")}
            <a href="https://www.govdata.de/dl-de/zero-2-0"
              >{t("pages.index.172")}</a
            >.
          </dd>
        </div><div>
          <dt>{t("pages.index.173")}</dt><dd>
            © <a href="https://www.openstreetmap.org/copyright"
              >{t("osm.contributors")}</a
            >{t("pages.index.174")}
          </dd>
        </div><div>
          <dt>{t("pages.index.175")}</dt><dd id="model-coverage">
            {t("pages.index.176")}
          </dd>
        </div><div>
          <dt>{t("pages.index.177")}</dt><dd>
            {t("pages.index.178")}
          </dd>
        </div><div>
          <dt>{t("pages.index.179")}</dt><dd>
            {t("pages.index.180")}
            <a href={localizePath("/records/", locale)}
              >{t("pages.index.181")}</a
            >
            {t("pages.index.182")}
          </dd>
        </div>
      </dl><details class="label-sources">
        <summary>{t("pages.index.183")}</summary><p>
          {t("pages.index.184")}
        </p><ul>
          {
            places.places.map((p) => (
              <li>
                <a href={p.sourceUrl}>{p.name}</a>
              </li>
            ))
          }
        </ul>
      </details><details class="label-sources">
        <summary>{t("pages.index.185")} {contextLabels.labels.length}</summary
        ><p>
          {t("pages.index.186")}
        </p><ul>
          {
            contextLabels.labels.map((label) => (
              <li>
                <a href={label.sourceUrl} lang="de">
                  {label.name}
                </a>
              </li>
            ))
          }
        </ul>
      </details>
      <p>
        <a href={localizePath("/terminology/", locale)}
          >{t("translation.terms")}</a
        >
      </p>
      <p class="model-date">
        {t("layouts.Base.39")}{" "}
        {generatedOn}{t("pages.index.187")}
      </p><a href={localizePath("/method/", locale)} class="primary-link"
        >{t("pages.index.188")} <Icon name="arrow" /></a
      >
    </dialog>
    <noscript
      ><div class="noscript-note">
        {t("pages.index.189")}
        <a href={localizePath("/records/", locale)}>{t("pages.index.190")}</a>
      </div></noscript
    >
    <script>
      import "../atlas/controller";
    </script>
  </body>
</html>
