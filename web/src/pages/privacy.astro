  </section>

  <section>
    <h2>{t("pages.privacy.227")}</h2>
    <p>
      {t("pages.privacy.228")}
    </p>
    <p>
      {t("pages.privacy.229")}
      <a href="https://www.datenschutz-berlin.de/">{t("pages.privacy.230")}</a>.
    </p>
  </section>
</Base>
