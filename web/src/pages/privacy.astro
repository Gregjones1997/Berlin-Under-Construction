---
import { forLocale, localeFromPath, localizePath } from "../lib/i18n";
const locale = localeFromPath(Astro.url.pathname);
const t = forLocale(locale);
import Base from "../layouts/Base.astro";
import { requireLegalAddress } from "../lib/legal-contact";

const address = requireLegalAddress(process.env.LEGAL_ADDRESS);
---

<Base
  title={t("pages.privacy.210")}
  heading={t("pages.privacy.211")}
  subtitle={t("pages.privacy.212")}
>
  <section>
    <h2>{t("pages.privacy.213")}</h2>
    <p>
      Gregory Anthony Jones<br />
      {address}<br />
      {t("pages.impressum.50")}<br />
      {t("pages.impressum.51")}
      <a href="mailto:jonesg158@gmail.com">jonesg158@gmail.com</a>
    </p>
  </section>

  <section>
    <h2>{t("pages.privacy.214")}</h2>
    <p>
      {t("pages.privacy.215")}
    </p>
  </section>

  <section>
    <h2>{t("pages.privacy.216")}</h2>
    <p>
      {t("pages.privacy.217")}
    </p>
    <p>
      {t("pages.privacy.218")}
      <a href="https://vercel.com/legal/privacy-notice"
        >{t("pages.privacy.219")}</a
      >.
    </p>
  </section>

  <section>
    <h2>{t("pages.privacy.220")}</h2>
    <p>
      {t("pages.privacy.221")}
      <a href="https://vercel.com/legal/dpa">{t("pages.privacy.222")}</a>
