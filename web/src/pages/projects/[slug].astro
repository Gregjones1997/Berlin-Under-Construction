---
import {
  forLocale,
  localeFromPath,
  localizePath,
  projectName,
  enumLabel,
} from "../../lib/i18n";
const locale = localeFromPath(Astro.url.pathname);
const t = forLocale(locale);
import RawFact from "../../components/RawFact.astro";
import Base from "../../layouts/Base.astro";
import {
  loadPublicProjectPages,
  type PublicProjectPage,
} from "../../lib/public-projects";

export function getStaticPaths() {
  return loadPublicProjectPages().map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: PublicProjectPage;
}

const { project } = Astro.props;
const identityFacts = project.publishedFacts.filter((fact) =>
  ["project_name", "project_location"].includes(fact.factType),
);
const leadFact =
  project.publishedFacts.find(
    (fact) => fact.factType === "milestone" && fact.factId.endsWith("current"),
  ) ?? project.publishedFacts.find((fact) => fact.factType === "milestone");
const currentFacts = [
  ...(leadFact ? [leadFact] : []),
  ...project.publishedFacts.filter((fact) => fact.factType === "status"),
];
const historyFacts = project.publishedFacts.filter((fact) =>
  fact.factId.includes("history"),
);
const groupedFactIds = new Set(
  [...identityFacts, ...currentFacts, ...historyFacts].map(
    (fact) => fact.factId,
  ),
);
const otherFacts = project.publishedFacts.filter(
  (fact) => !groupedFactIds.has(fact.factId),
);
---

<Base
  title={`${projectName(project, locale)} — Berlin, Under Construction`}
  heading={projectName(project, locale)}
  headingLang={locale}
>
  <section aria-labelledby="current-heading">
    <h2 id="current-heading">{t("pages.projects.slug..231")}</h2>
    <p class="section-intro">
      {t("pages.projects.slug..232")}
    </p>
    {
      currentFacts.map((fact) => (
        <RawFact fact={fact} lead={fact.factId === leadFact?.factId} />
      ))
    }
    {
      historyFacts.length > 0 && (
        <p>
          <a href="#history-heading">{t("pages.projects.slug..233")}</a>
        </p>
      )
    }
    <p>
      <a href={localizePath(`/#${project.projectId}`, locale)}
        >{t("pages.projects.slug..234")}</a
      >
    </p>
  </section>

  <section aria-labelledby="identity-heading">
    <h2 id="identity-heading">{t("pages.projects.slug..235")}</h2>
    {identityFacts.map((fact) => <RawFact fact={fact} />)}
  </section>

  {
    historyFacts.length > 0 && (
      <section aria-labelledby="history-heading">
        <h2 id="history-heading">{t("pages.projects.slug..236")}</h2>
        <p class="section-intro">{t("pages.projects.slug..237")}</p>
        {historyFacts.map((fact) => (
          <RawFact fact={fact} />
        ))}
      </section>
    )
  }

  {
    otherFacts.length > 0 && (
      <section aria-labelledby="other-facts-heading">
        <h2 id="other-facts-heading">{t("pages.projects.slug..238")}</h2>
        {otherFacts.map((fact) => (
          <RawFact fact={fact} />
        ))}
      </section>
    )
  }

  {
    project.conflicts.length > 0 && (
      <section aria-labelledby="conflicts-heading">
        <h2 id="conflicts-heading">{t("pages.projects.slug..239")}</h2>
        {project.conflicts.map((conflict) => (
          <section class="conflict" data-conflict-id={conflict.conflictId}>
            <h3>{t("pages.projects.slug..240")}</h3>
            <div class="pair">
              {conflict.facts.map((fact) => (
                <RawFact fact={fact} />
              ))}
            </div>
            <p class="note">{t("pages.projects.slug..241")}</p>
          </section>
        ))}
      </section>
    )
  }

  {
    project.withheldFacts.length > 0 && (
      <section aria-labelledby="withheld-heading">
        <h2 id="withheld-heading">{t("pages.index.108")}</h2>
        {project.withheldFacts.map((fact) => (
          <article
            class="withheld"
            data-fact-id={fact.factId}
            data-reason-code={fact.reasonCode}
          >
            <h3>{enumLabel(fact.factType, locale)}</h3>
            <p>{t(`reason.${fact.reasonCode}`)}</p>
          </article>
        ))}
      </section>
    )
  }

  <section>
    <h2>{t("pages.index.164")}</h2>
    <p>
      <a href={localizePath(project.correctionPath, locale)}
        >{t("pages.projects.slug..247")}</a
      >
    </p>
  </section>
</Base>
