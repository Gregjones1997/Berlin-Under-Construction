---
import {
  forLocale,
  localeFromPath,
  localizePath,
  projectName,
  listingName,
  factText,
  dateText,
  enumLabel,
} from "../lib/i18n";
const locale = localeFromPath(Astro.url.pathname);
const t = forLocale(locale);
import { readFileSync } from "node:fs";
import { resolve } from "node:path";
import basicListings from "../atlas/basic-listings.json";
import Base from "../layouts/Base.astro";
import { loadPublicProjectPages } from "../lib/public-projects";

type Position = {
  projectId: string;
  latitude: number;
  longitude: number;
};

type Boundary = {
  features: Array<{
    geometry: {
      type: "MultiPolygon";
      coordinates: number[][][][];
    };
  }>;
};

const dataRoot = resolve(process.cwd(), "../public/data/map");
const boundary = JSON.parse(
  readFileSync(resolve(dataRoot, "berlin-boundary.geojson"), "utf8"),
) as Boundary;
const markerData = JSON.parse(
  readFileSync(resolve(dataRoot, "pilot-marker-positions.json"), "utf8"),
) as { positions: Position[] };
const projects = loadPublicProjectPages();
const projectById = new Map(
  projects.map((project) => [project.projectId, project]),
);

if (markerData.positions.some((position) => position.projectId === "C-019")) {
  throw new Error("C-019 must remain unplaced while its location is withheld");
}

const width = 800;
const height = 600;
const padding = 30;
const rings = boundary.features.flatMap((feature) =>
  feature.geometry.coordinates.flatMap((polygon) => polygon),
);
const points = rings.flat();
const longitudes = points.map(([longitude]) => longitude);
const latitudes = points.map(([, latitude]) => latitude);
const minLongitude = Math.min(...longitudes);
const maxLongitude = Math.max(...longitudes);
const minLatitude = Math.min(...latitudes);
const maxLatitude = Math.max(...latitudes);

function mapPoint(longitude: number, latitude: number) {
  return {
    x:
      padding +
      ((longitude - minLongitude) / (maxLongitude - minLongitude)) *
        (width - 2 * padding),
    y:
      padding +
      ((maxLatitude - latitude) / (maxLatitude - minLatitude)) *
        (height - 2 * padding),
  };
}

const boundaryPaths = rings.map(
  (ring) =>
    ring
      .map(([longitude, latitude], index) => {
        const { x, y } = mapPoint(longitude, latitude);
        return `${index === 0 ? "M" : "L"}${x.toFixed(2)},${y.toFixed(2)}`;
      })
      .join(" ") + " Z",
);

const placedProjects = markerData.positions.map((position) => {
  const project = projectById.get(position.projectId);
  if (!project) {
    throw new Error(`Unknown marker project ${position.projectId}`);
  }
  const publishedLocation = project.publishedFacts.some(
    (fact) => fact.factType === "project_location",
  );
  if (!publishedLocation) {
    throw new Error(
      `Marker project ${position.projectId} has no published location`,
    );
  }
  return { ...project, ...mapPoint(position.longitude, position.latitude) };
});

const c019 = projectById.get("C-019");
const c019Location = c019?.withheldFacts.find(
  (fact) => fact.factId === "c019-project-location",
);
if (
  !c019 ||
  c019Location?.reasonCode !== "source_string_requires_owner_verification"
) {
  throw new Error("C-019 withheld-location state is missing");
}
---

<Base
  pageClass="records-page"
  title={t("pages.records.248")}
  heading={t("pages.records.249")}
  subtitle={t("pages.records.250")}
>
  <div class="index-opening">
    <section class="dossier-directory" aria-labelledby="dossiers-heading">
      <div class="directory-heading">
        <p class="document-eyebrow">{t("pages.records.251")}</p><h2
          id="dossiers-heading"
        >
          {t("pages.records.252")}<br />{t("pages.records.253")}
        </h2>
      </div>
      <p>{t("pages.records.254")}</p>
      <nav aria-label={t("pages.records.255")}>
        <ol class="dossier-cards">
          {
            projects.map((project, index) => (
              <li>
                <a href={localizePath(`/projects/${project.slug}/`, locale)}>
                  <>
                    <span class="dossier-number">
                      0{index + 1} / {project.projectId}
                    </span>
                    <strong lang={locale}>
                      {projectName(project, locale)}
                    </strong>
                    <span class="dossier-card-action">
                      {t("pages.records.256")} <span aria-hidden="true">↗</span>
                    </span>
                  </>
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
    </section>
    <section aria-labelledby="map-heading">
      <figure aria-labelledby="map-heading map-caption">
        <h2 id="map-heading">{t("pages.records.257")}</h2>
        <svg
          viewBox={`0 0 ${width} ${height}`}
          role="img"
          aria-labelledby="map-title map-description"
        >
          <title id="map-title">
            {t("pages.records.258")}
          </title>
          <desc id="map-description">{t("records.description")}</desc>
          {
            boundaryPaths.map((path) => (
              <path d={path} fill="none" stroke="currentColor" />
            ))
          }
          {
            placedProjects.map((project) => (
              <a
                href={localizePath(`/projects/${project.slug}/`, locale)}
                data-map-marker="placed"
                data-project-id={project.projectId}
                aria-label={`${project.projectId}: ${projectName(project, locale)}`}
              >
                <circle cx={project.x} cy={project.y} r="8" />
                <text x={project.x + 12} y={project.y + 4}>
                  {project.projectId}
                </text>
              </a>
            ))
          }
        </svg>
        <figcaption id="map-caption">
          <p>
            {t("pages.records.259")}
          </p>
          <p>
            {t("pages.records.260")}
            <a href="https://www.bkg.bund.de">BKG</a> 2026
            <a href="https://www.govdata.de/dl-de/by-2-0"
              >{t("pages.records.261")}</a
            >
            (Daten verändert), Datenquellen:
            <a
              href="https://sgx.geodatenzentrum.de/web_public/gdz/datenquellen/datenquellen_vg_nuts.pdf"
              >{t("pages.records.262")}</a
            >.
          </p>
          <p>
            {t("pages.records.263")}
            <a href="https://www.openstreetmap.org/copyright"
              >{t("osm.contributors")}</a
            >{t("pages.records.264")}
          </p>
        </figcaption>
      </figure>
    </section>
  </div>
  <section aria-labelledby="unplaced-heading">
    <h2 id="unplaced-heading">{t("pages.records.265")}</h2>
    <p data-reason-code={c019Location.reasonCode}>
      <a href={localizePath(`/projects/${c019.slug}/`, locale)}
        >C-019 — <span lang={locale}>{projectName(c019, locale)}</span></a
      ><br />
      {t("pages.records.266")}<br />
      {t("pages.records.267")}
    </p>
  </section>

  <section class="register-directory" aria-labelledby="basic-heading">
    <h2 id="basic-heading">{t("pages.records.268")}</h2><p>
      {t("pages.records.269")}
    </p><ul>
      {
        basicListings.records.map((project) => (
          <li>
            <a href={localizePath(`/#${project.id}`, locale)} lang={locale}>
              {listingName(project, locale)}
            </a>{" "}
            · <a href={project.sourceUrl}>{t("components.RawFact.27")}</a> ·{" "}
            <a href={localizePath("/corrections/", locale)}>
              {t("pages.records.270")}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
  <details class="index-method">
    <summary>{t("pages.records.271")}</summary>
    <section aria-labelledby="introduction-heading">
      <h2 id="introduction-heading">{t("pages.records.272")}</h2>
      <p>
        {t("pages.records.273")}
      </p>
    </section>
    <section aria-labelledby="demonstrates-heading">
      <h2 id="demonstrates-heading">{t("pages.records.274")}</h2>
      <p>
        {t("pages.records.275")}
      </p>
      <p>
        {t("pages.records.276")}
        <a href="https://github.com/Gregjones1997/Berlin-Under-Construction"
          >{t("pages.records.277")}</a
        >.
      </p>
    </section>
  </details>
  <section>
    <nav aria-label={t("pages.index.163")}>
      <h2>{t("pages.index.163")}</h2>
      <ul>
        <li>
          <a href={localizePath("/impressum/", locale)}
            >{t("layouts.Base.37")}</a>
        </li>
        <li>
          <a href={localizePath("/privacy/", locale)}
            >{t("pages.privacy.211")}</a>
        </li>
      </ul>
    </nav>
  </section>
</Base>
