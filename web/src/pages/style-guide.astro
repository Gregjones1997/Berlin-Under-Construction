---
import Base from "../layouts/Base.astro";
import AtlasIcon from "../components/AtlasIcon.astro";
import RawFact from "../components/RawFact.astro";
import { loadPublicProjectPages } from "../lib/public-projects";
import "../styles/atlas.css";
import "../styles/style-guide.css";

const projects = loadPublicProjectPages();
const c014 = projects.find((project) => project.projectId === "C-014");
const c019 = projects.find((project) => project.projectId === "C-019");
if (!c014 || !c019) throw new Error("Style guide specimens require the pilot projects");

const leadFact =
  c014.publishedFacts.find((fact) => fact.factId === "c014-expected-completion-current") ??
  c014.publishedFacts.find((fact) => fact.factType === "milestone");
const statusFact = c014.publishedFacts.find((fact) => fact.factType === "status");
const conflict = c014.conflicts[0];
const withheldFact = c019.withheldFacts[0] ?? c014.withheldFacts[0];
---

<Base
  title="City Desk / Style guide"
  heading="City Desk / style guide"
  subtitle="A rendered inventory of the native Lumos adaptation used by the atlas, index and source dossiers."
  pageClass="style-guide-page"
>
  <div class="guide-intro">
    <div>
      <p class="guide-label">Actual Astro route / production specimens</p>
      <p>
        This page is generated by the same Astro build as the working atlas. It
        consumes the live token file, SiteHeader, RawFact and atlas action styles;
        the examples below keep the source-backed product boundary visible.
      </p>
    </div>
    <p class="guide-note">
      German source values remain canonical. Rust is an ordinary action role;
      conflict and withheld states retain their own semantic colours.
    </p>
  </div>

  <section class="guide-section" aria-labelledby="type-heading">
    <h2 id="type-heading">Typography / real project copy</h2>
    <p class="section-intro">
      Raw family, weight, size, leading and tracking metrics are named separately
      from the roles used by the actual pages. System fonts remain local and
      predictable; no external font request is required.
    </p>
    <div class="guide-type-grid">
      <article class="guide-card guide-type-display">
        <p class="guide-label">Display / interface</p>
        <h3 lang="de">{c014.projectNameDe}</h3>
        <p>A city in progress. A record of change.</p>
        <small>--type-display-family · --type-display-size · --type-display-leading</small>
      </article>
      <article class="guide-card guide-type-reading">
        <p class="guide-label">Context / source voice</p>
        <h3 lang="de">{leadFact?.evidence?.exactTextDe ?? "Fertigstellung: 2026"}</h3>
        <p class="guide-evidence-copy">The source wording is shown verbatim inside its evidence context.</p>
        <small>--type-context-family · --type-context-size · --type-context-leading</small>
      </article>
      <article class="guide-card guide-type-reference">
        <p class="guide-label">Label / provenance</p>
        <h3>C-014 · SOURCE-BACKED DOSSIER</h3>
        <p>Published milestone · as of 2026-08-06 · exact source span available</p>
        <small>--type-label-family · --type-label-size · --type-label-tracking</small>
      </article>
    </div>
  </section>

  <section class="guide-section" aria-labelledby="colour-heading">
    <h2 id="colour-heading">Semantic colour roles / paired surfaces</h2>
    <p class="section-intro">
      Swatches feed semantic surfaces and text roles. The map's categorical
      geometry colours stay outside this action/state set.
    </p>
    <div class="guide-swatch-grid">
      <div class="guide-swatch" data-swatch="canvas"><strong>Canvas / paper</strong><code>--surface-canvas<br />#f6f7f4</code></div>
      <div class="guide-swatch" data-swatch="panel"><strong>Panel / ink</strong><code>--surface-panel · --text-primary<br />#ffffff / #202925</code></div>
      <div class="guide-swatch" data-swatch="action"><strong>Action / inverse</strong><code>--action-default · --text-inverse<br />#a83d1c / #f6f7f4</code></div>
      <div class="guide-swatch" data-swatch="conflict"><strong>Conflict / reason</strong><code>--state-conflict · --state-conflict-surface<br />#a5121a / #fcf5f4</code></div>
    </div>
  </section>

  <section class="guide-section" aria-labelledby="control-heading">
    <h2 id="control-heading">Controls / action, selected, disabled, focus</h2>
    <p class="section-intro">
      Actions retain comfortable 44px targets on ordinary phone layouts. The
      selected state is reserved for a current view; disabled controls explain a
      capability boundary through their surrounding copy.
    </p>
    <div class="guide-control-grid">
      <a class="primary-link guide-primary" href="/projects/europaplatz-sued/">Open full dossier <AtlasIcon name="arrow" /></a>
      <a class="guide-action-link" href="/records/">Browse the project index <span aria-hidden="true">↗</span></a>
      <button class="guide-button" type="button" aria-pressed="true">Selected record <span aria-hidden="true">✓</span></button>
      <button class="guide-button" type="button" disabled>Unavailable while loading</button>
      <button class="guide-button guide-focus" type="button">Keyboard focus ring</button>
    </div>
    <details class="guide-disclosure" open>
      <summary>Evidence disclosure / native details</summary>
      <p>
        Exact source wording stays behind the native disclosure on static dossier
        pages. It remains reachable by keyboard and does not require client
        JavaScript.
      </p>
      {statusFact && <blockquote lang="de">{statusFact.evidence?.exactTextDe}</blockquote>}
      <a href={statusFact?.evidence?.sourceUrl ?? "/method/"}>Original source</a>
    </details>
  </section>

  <section class="guide-section" aria-labelledby="evidence-heading">
    <h2 id="evidence-heading">Evidence states / actual component specimens</h2>
    <p class="section-intro">
      These specimens use the current pilot projection. Success shows a sourced
      fact, conflict keeps competing values inside its conflict presentation, and
      withheld shows a reason without rendering a value.
    </p>
    <div class="guide-fact">
      {leadFact && <RawFact fact={leadFact} lead compact />}
    </div>
    {conflict && (
      <div class="guide-conflict" data-conflict-id={conflict.conflictId}>
        <h3>Conflict / values remain paired</h3>
        <div class="guide-conflict-pair">
          {conflict.facts.map((fact) => <RawFact fact={fact} compact />)}
        </div>
        <p>Neither official value is promoted while the sources remain unreconciled.</p>
      </div>
    )}
    <div class="guide-state-grid">
      <article class="guide-state guide-state-empty">
        <p class="guide-label">Empty / unplaced</p>
        <h3>Location withheld</h3>
        <p>The record remains available while the location field is withheld pending source verification.</p>
        <a class="guide-action-link" href={c019.correctionPath}>Suggest a correction <span aria-hidden="true">↗</span></a>
      </article>
      <article class="guide-state guide-state-error" role="alert">
        <p class="guide-label">Error / recoverable</p>
        <h3>The atlas could not load.</h3>
        <p>Your browser could not start the 3D view. The project records are still available.</p>
        <a class="guide-action-link" href="/records/">Explore the accessible project index <span aria-hidden="true">→</span></a>
      </article>
      <article class="guide-state guide-state-success">
        <p class="guide-label">Success / evidence available</p>
        <h3 lang="de">{c014.projectNameDe}</h3>
        <p>Current source-stated position is visible with an exact German evidence span and original-source link.</p>
        <a class="guide-action-link" href="/projects/europaplatz-sued/">Read the dossier <span aria-hidden="true">↗</span></a>
      </article>
    </div>
    {withheldFact && <p class="guide-note">Withheld reason code retained in the production component: <code>{withheldFact.reasonCode}</code>. No withheld value is displayed.</p>}
  </section>

  <section class="guide-section" aria-labelledby="phone-heading">
    <h2 id="phone-heading">Phone layouts / compact evidence desk</h2>
    <p class="section-intro">
      The same real project copy reflows into narrow reading surfaces. The 390px
      and 320px specimens keep the action readable and allow evidence to expand
      without clipping.
    </p>
    <div class="guide-phone-grid">
      <figure>
        <div class="guide-phone-frame" data-width="390">
          <header>BERLIN / UNDER CONSTRUCTION</header>
          <main>
            <p class="guide-label">C-014 / PROJECT RECORD</p>
            <h3 lang="de">{c014.projectNameDe}</h3>
            <p lang="de">{leadFact?.valueDe}</p>
            <a class="guide-action-link" href="/projects/europaplatz-sued/">Review evidence <span aria-hidden="true">↗</span></a>
          </main>
        </div>
        <figcaption>390px / dossier opening</figcaption>
      </figure>
      <figure>
        <div class="guide-phone-frame" data-width="320">
          <header>ATLAS / RECOVERY</header>
          <main>
            <p class="guide-label">3D VIEW UNAVAILABLE</p>
            <h3>The atlas could not load.</h3>
            <p>Your project records remain available in the accessible index.</p>
            <a class="guide-action-link" href="/records/">Open project index <span aria-hidden="true">→</span></a>
          </main>
        </div>
        <figcaption>320px / terminal recovery</figcaption>
      </figure>
    </div>
  </section>

  <section class="guide-section" aria-labelledby="mapping-heading">
    <h2 id="mapping-heading">Lumos mapping / native implementation</h2>
    <table class="guide-token-table">
      <thead><tr><th scope="col">Foundation</th><th scope="col">Live role</th><th scope="col">Production use</th></tr></thead>
      <tbody>
        <tr><th scope="row">Typography</th><td><code>--type-display-* · --type-heading-* · --type-context-* · --type-label-*</code></td><td>Atlas introduction, dossier headings, German source excerpts, IDs and metadata.</td></tr>
        <tr><th scope="row">Themes</th><td><code>--surface-* · --text-* · --border-* · --action-*</code></td><td>SiteHeader, atlas controls, dossier links, index cards and native disclosures.</td></tr>
        <tr><th scope="row">Evidence states</th><td><code>--state-conflict-* · --state-withheld-* · --state-warning</code></td><td>Conflict pairs, withheld reasons and passed-date warnings remain distinct from rust actions.</td></tr>
        <tr><th scope="row">Size / layout</th><td><code>--space-* · --container-* · --layout-gutter · --control-target</code></td><td>Fluid atlas rail, reading pages, style-guide specimens and 44px ordinary phone controls.</td></tr>
      </tbody>
    </table>
    <p class="guide-note">This is a production Lumos adaptation for Astro. Font trim and Webflow starter conventions are not claimed; calibrated line heights and browser-native alignment are documented instead.</p>
  </section>
</Base>
