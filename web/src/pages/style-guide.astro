---
import {
  forLocale,
  localeFromPath,
  localizePath,
  projectName,
  listingName,
  factText,
  dateText,
  enumLabel,
} from "../lib/i18n";
const locale = localeFromPath(Astro.url.pathname);
const t = forLocale(locale);
import Base from "../layouts/Base.astro";
import AtlasIcon from "../components/AtlasIcon.astro";
import RawFact from "../components/RawFact.astro";
import { loadPublicProjectPages } from "../lib/public-projects";
import "../styles/atlas.css";
import "../styles/style-guide.css";

const projects = loadPublicProjectPages();
const c014 = projects.find((project) => project.projectId === "C-014");
const c019 = projects.find((project) => project.projectId === "C-019");
if (!c014 || !c019)
  throw new Error("Style guide specimens require the pilot projects");

const leadFact =
  c014.publishedFacts.find(
    (fact) => fact.factId === "c014-expected-completion-current",
  ) ?? c014.publishedFacts.find((fact) => fact.factType === "milestone");
const statusFact = c014.publishedFacts.find(
  (fact) => fact.factType === "status",
);
const conflict = c014.conflicts[0];
const withheldFact = c019.withheldFacts[0] ?? c014.withheldFacts[0];
---

<Base
  title={t("pages.style.guide.278")}
  heading={t("pages.style.guide.279")}
  subtitle={t("pages.style.guide.280")}
  pageClass="style-guide-page"
>
  <div class="guide-intro">
    <div>
      <p class="guide-label">{t("pages.style.guide.281")}</p>
      <p>
        {t("pages.style.guide.282")}
      </p>
    </div>
    <p class="guide-note">
      {t("pages.style.guide.283")}
    </p>
  </div>

  <section class="guide-section" aria-labelledby="type-heading">
    <h2 id="type-heading">{t("pages.style.guide.284")}</h2>
    <p class="section-intro">
      {t("pages.style.guide.285")}
    </p>
    <div class="guide-type-grid">
      <article class="guide-card guide-type-display">
        <p class="guide-label">{t("pages.style.guide.286")}</p>
        <h3 lang={locale}>{projectName(c014, locale)}</h3>
        <p>{t("pages.style.guide.287")}</p>
        <small
          >--type-display-family · --type-display-size · --type-display-leading</small
        >
      </article>
      <article class="guide-card guide-type-reading">
        <p class="guide-label">{t("pages.style.guide.288")}</p>
        <h3 lang={locale}>{leadFact && factText(leadFact, locale)}</h3>
        <p class="guide-evidence-copy">{t("pages.style.guide.290")}</p>
        <small
          >--type-context-family · --type-context-size · --type-context-leading</small
        >
      </article>
      <article class="guide-card guide-type-reference">
        <p class="guide-label">{t("pages.style.guide.291")}</p>
        <h3>C-014 {t("pages.index.86")}</h3>
        <p>{t("pages.style.guide.292")}</p>
        <small
          >--type-label-family · --type-label-size · --type-label-tracking</small
        >
      </article>
    </div>
  </section>

  <section class="guide-section" aria-labelledby="colour-heading">
    <h2 id="colour-heading">{t("pages.style.guide.293")}</h2>
    <p class="section-intro">
      {t("pages.style.guide.294")}
    </p>
    <div class="guide-swatch-grid">
      <div class="guide-swatch" data-swatch="canvas">
        <strong>{t("pages.style.guide.295")}</strong><code
          >--surface-canvas<br />#f6f7f4</code>
      </div>
      <div class="guide-swatch" data-swatch="panel">
        <strong>{t("pages.style.guide.296")}</strong><code
          >--surface-panel · --text-primary<br />#ffffff / #202925</code>
      </div>
      <div class="guide-swatch" data-swatch="action">
        <strong>{t("pages.style.guide.297")}</strong><code
          >--action-default · --text-inverse<br />#a83d1c / #f6f7f4</code>
      </div>
      <div class="guide-swatch" data-swatch="conflict">
        <strong>{t("pages.style.guide.298")}</strong><code
          >--state-conflict · --state-conflict-surface<br />#a5121a / #fcf5f4</code>
      </div>
    </div>
  </section>

  <section class="guide-section" aria-labelledby="control-heading">
    <h2 id="control-heading">{t("pages.style.guide.299")}</h2>
    <p class="section-intro">
      {t("pages.style.guide.300")}
    </p>
    <div class="guide-control-grid">
      <a
        class="primary-link guide-primary"
        href={localizePath("/projects/europaplatz-sued/", locale)}
        >{t("pages.index.109")} <AtlasIcon name="arrow" /></a
      >
      <a class="guide-action-link" href={localizePath("/records/", locale)}
        >{t("pages.style.guide.301")} <span aria-hidden="true">↗</span></a
      >
      <button class="guide-button" type="button" aria-pressed="true"
        >{t("pages.style.guide.302")} <span aria-hidden="true">✓</span></button
      >
      <button class="guide-button" type="button" disabled
        >{t("pages.style.guide.303")}</button
      >
      <button class="guide-button guide-focus" type="button"
        >{t("pages.style.guide.304")}</button
      >
    </div>
    <details class="guide-disclosure" open>
      <summary>{t("pages.style.guide.305")}</summary>
      <p>
        {t("pages.style.guide.306")}
      </p>
      {
        statusFact && (
          <blockquote lang="de">{statusFact.evidence?.exactTextDe}</blockquote>
        )
      }
      <a href={statusFact?.evidence?.sourceUrl ?? "/method/"}
        >{t("components.RawFact.27")}</a
      >
    </details>
  </section>

  <section class="guide-section" aria-labelledby="evidence-heading">
    <h2 id="evidence-heading">{t("pages.style.guide.307")}</h2>
    <p class="section-intro">
      {t("pages.style.guide.308")}
    </p>
    <div class="guide-fact">
      {leadFact && <RawFact fact={leadFact} lead compact />}
    </div>
    {
      conflict && (
        <div class="guide-conflict" data-conflict-id={conflict.conflictId}>
          <h3>{t("pages.style.guide.309")}</h3>
          <div class="guide-conflict-pair">
            {conflict.facts.map((fact) => (
              <RawFact fact={fact} compact />
            ))}
          </div>
          <p>{t("pages.style.guide.310")}</p>
        </div>
      )
    }
    <div class="guide-state-grid">
      <article class="guide-state guide-state-empty">
        <p class="guide-label">{t("pages.style.guide.311")}</p>
        <h3>{t("pages.index.75")}</h3>
        <p>{t("pages.style.guide.312")}</p>
        <a
          class="guide-action-link"
          href={localizePath(c019.correctionPath, locale)}
          >{t("pages.index.102")} <span aria-hidden="true">↗</span></a
        >
      </article>
      <article class="guide-state guide-state-error" role="alert">
        <p class="guide-label">{t("pages.style.guide.313")}</p>
        <h3>{t("pages.index.64")}</h3>
        <p>{t("pages.style.guide.314")}</p>
        <a class="guide-action-link" href={localizePath("/records/", locale)}
          >{t("pages.style.guide.315")} <span aria-hidden="true">→</span></a
        >
      </article>
      <article class="guide-state guide-state-success">
        <p class="guide-label">{t("pages.style.guide.316")}</p>
        <h3 lang={locale}>{projectName(c014, locale)}</h3>
        <p>{t("pages.style.guide.317")}</p>
        <a
          class="guide-action-link"
          href={localizePath("/projects/europaplatz-sued/", locale)}
          >{t("pages.records.256")} <span aria-hidden="true">↗</span></a
        >
      </article>
    </div>
    {
      withheldFact && (
        <p class="guide-note">
          {t("pages.style.guide.318")} <code>{withheldFact.reasonCode}</code>
          {t("pages.style.guide.319")}
        </p>
      )
    }
  </section>

  <section class="guide-section" aria-labelledby="phone-heading">
    <h2 id="phone-heading">{t("pages.style.guide.320")}</h2>
    <p class="section-intro">
      {t("pages.style.guide.321")}
    </p>
    <div class="guide-phone-grid">
      <figure>
        <div class="guide-phone-frame" data-width="390">
          <header>{t("pages.style.guide.322")}</header>
          <main>
            <p class="guide-label">C-014 {t("pages.index.85")}</p>
            <h3 lang={locale}>{projectName(c014, locale)}</h3>
            <p lang={locale}>{leadFact && factText(leadFact, locale)}</p>
            <a
              class="guide-action-link"
              href={localizePath("/projects/europaplatz-sued/", locale)}
              >{t("pages.style.guide.323")} <span aria-hidden="true">↗</span></a
            >
          </main>
        </div>
        <figcaption>{t("pages.style.guide.324")}</figcaption>
      </figure>
      <figure>
        <div class="guide-phone-frame" data-width="320">
          <header>{t("pages.style.guide.325")}</header>
          <main>
            <p class="guide-label">{t("pages.style.guide.326")}</p>
            <h3>{t("pages.index.64")}</h3>
            <p>{t("pages.style.guide.327")}</p>
            <a
              class="guide-action-link"
              href={localizePath("/records/", locale)}
              >{t("pages.style.guide.328")} <span aria-hidden="true">→</span></a
            >
          </main>
        </div>
        <figcaption>{t("pages.style.guide.329")}</figcaption>
      </figure>
    </div>
  </section>

  <section class="guide-section" aria-labelledby="mapping-heading">
    <h2 id="mapping-heading">{t("pages.style.guide.330")}</h2>
    <table class="guide-token-table">
      <thead
        ><tr
          ><th scope="col">{t("pages.style.guide.331")}</th><th scope="col"
            >{t("pages.style.guide.332")}</th
          ><th scope="col">{t("pages.style.guide.333")}</th></tr
        ></thead
      >
      <tbody>
        <tr
          ><th scope="row">{t("pages.style.guide.334")}</th><td
            ><code
              >--type-display-* · --type-heading-* · --type-context-* ·
              --type-label-*</code
            ></td
          ><td>{t("pages.style.guide.335")}</td></tr
        >
        <tr
          ><th scope="row">{t("pages.style.guide.336")}</th><td
            ><code>--surface-* · --text-* · --border-* · --action-*</code></td
          ><td>{t("pages.style.guide.337")}</td></tr
        >
        <tr
          ><th scope="row">{t("pages.style.guide.338")}</th><td
            ><code
              >--state-conflict-* · --state-withheld-* · --state-warning</code
            ></td
          ><td>{t("pages.style.guide.339")}</td></tr
        >
        <tr
          ><th scope="row">{t("pages.style.guide.340")}</th><td
            ><code
              >--space-* · --container-* · --layout-gutter · --control-target</code
            ></td
          ><td>{t("pages.style.guide.341")}</td></tr
        >
      </tbody>
    </table>
    <p class="guide-note">{t("pages.style.guide.342")}</p>
  </section>
</Base>
